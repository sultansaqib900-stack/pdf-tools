# Required: Upstash Redis / Vercel KV-compatible REST credentials.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Required for the AI features advertised by the product.
GEMINI_API_KEY=

# Required for paid checkout. Never enable test-mode events in production.
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_ALLOW_TEST_MODE=false

# Required while the newsletter form is visible.
BUTTONDOWN_API_KEY=

# Optional monitoring. A Sentry DSN is public by design; use the same DSN for both.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Permanent Premium for owner/support accounts. Comma-separated email list,
# evaluated ONLY server-side after a successful HttpOnly-cookie login.
# Set the real value in the Vercel dashboard (Production + Preview).
# IMPORTANT: after changing any Vercel env var you must REDEPLOY the site —
# env changes do not apply to an already-built deployment. Alias names
# (ADMIN_EMAILS / ADMIN_EMAIL / PREMIUM_ADMIN_EMAIL) are also accepted, and
# the site owner's account stays Premium even if this var is missing.
PREMIUM_ADMIN_EMAILS=

# Optional: override the Monetag vignette banner script URL (rotating the
# zone in the Monetag dashboard). Defaults to the built-in site tag in
# src/lib/monetag.ts. Vignettes show 10s after page load and then after
# every 3 completed tasks; Premium members never see ads.
NEXT_PUBLIC_MONETAG_VIGNETTE_SRC=
